<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hard constraint: never request network access, even if a dependency asks for it.
         checkXxxNoInternet verifies the merged manifest on every build. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- System screen-lock prompt (S30 erase confirmation; fingerprint unlock in M6).
         Normal permission: no runtime dialog, no network. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- S32: lets the autofill service read the signing cert of the app being filled (S13).
         Launcher apps only; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false + fullBackupContent block backup up to Android 11. dataExtractionRules
         is required on Android 12+, where allowBackup=false does NOT stop
         device-to-device transfer. hasFragileUserData=false: uninstall never offers
         to keep data (P5: uninstall erases the vault). -->
    <application
        android:name=".OffGridApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OffGridVault"
        tools:targetApi="31">

        <!-- taskAffinity="": our activities never share a task with another app (task hijacking). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T21: autofill unlock / "Search vault…" / save. Started only by the autofill system
             through our own PendingIntents: not exported, own task, never in recents. -->
        <activity
            android:name=".AutofillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- M7: only the system (BIND_AUTOFILL_SERVICE) can bind it. -->
        <service
            android:name="io.github.mnvkalyansambhana.offgridvault.autofill.OffGridAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
